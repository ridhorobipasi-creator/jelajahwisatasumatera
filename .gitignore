# ── File mentah / sumber (besar, tidak ikut ke GitHub) ──
_sumber/
assets/*/_masuk/
*.pdf
*.mov

# ── Video: disemat dari YouTube, berkasnya tidak ikut ke sini ──
# Berkasnya jauh di atas batas 100 MB per file yang dipaksakan GitHub. Halaman
# menyematnya dari YouTube (lihat peta YOUTUBE di build_trip.py); yang ikut ke
# repo cuma gambar sampulnya di assets/poster/.
# assets/video/ tetap disimpan lokal sebagai arsip — dari situ sampul dibuat
# dan dari situ pula video diunggah ulang kalau perlu.
assets/*/*.mp4

# ── Hasil uji coba generator ──
# deploy.bat memakai `git add -A`, jadi berkas coba-coba di folder root harus
# disebut di sini kalau tidak mau ikut terkirim ke situs.
preview/
_preview-*.html

# ── Rahasia (jangan pernah ikut ke GitHub) ──
.env*
.vercel/

# ── Cache & file sistem ──
__pycache__/
*.pyc
.DS_Store
Thumbs.db
